# One of the two auth options:

# Option A — Claude subscription OAuth token (run `claude setup-token` to mint one)
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# Option B — Claude Console API key
# ANTHROPIC_API_KEY=sk-ant-api03-...

# Optional tuning
# AUTOUI_MODEL=claude-fable-5
# AUTOUI_EFFORT=medium
# PORT=3000
